# A nightly copy of Swifty Home: the database (an online copy, so the hub keeps running),
# swifty.toml, and a 0600 archive of the secret store, in /var/backups/swifty-home.
# Started by swifty-home-backup.timer. Copy the backups off this machine as well: a copy
# on the same disk does not survive the disk.
[Unit]
Description=Swifty Home backup
After=swifty-home.service

[Service]
Type=oneshot
User=swifty-home
Group=swifty-home
ExecStart=/usr/local/bin/swifty backup --out /var/backups/swifty-home --keep-days 14
UMask=0077

StateDirectory=swifty-home
StateDirectoryMode=0700
ConfigurationDirectory=swifty-home
ConfigurationDirectoryMode=0750
# install.sh creates this directory, owned by swifty-home, mode 0700.
ReadWritePaths=/var/backups/swifty-home

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
