[package]
name = "{{crate}}"
description = "Swifty Home plugin for {{name}}"
{{#workspace}}
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true
{{/workspace}}
{{#standalone}}
version = "0.1.0"
edition = "2021"
license = "Apache-2.0"
publish = false
{{/standalone}}

[lib]
name = "{{lib}}"
path = "src/lib.rs"

[dependencies]
{{#workspace}}
async-trait.workspace = true
serde.workspace = true
serde_json.workspace = true
swifty-plugin-api.workspace = true
{{/workspace}}
{{#standalone}}
async-trait = "0.1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
swifty-plugin-api = "0.1"
{{/standalone}}

[dev-dependencies]
{{#workspace}}
swifty-plugin-testkit.workspace = true
tokio.workspace = true
{{/workspace}}
{{#standalone}}
swifty-plugin-testkit = "0.1"
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
{{/standalone}}
