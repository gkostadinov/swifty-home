{
  "plugin": "sonos",
  "source": "plugins/sonos/src/config.rs",
  "config_version": 1,
  "root": "SonosConfig",
  "structs": {
    "SonosConfig": {
      "speakers": { "type": "rows", "of": "SpeakerConfig", "min_rows": 1, "max_rows": 32 }
    },
    "SpeakerConfig": {
      "id": { "type": "string", "format": "local_id" },
      "url": { "type": "string", "format": "url", "schemes": ["http"] },
      "read_only": { "type": "bool", "optional": true }
    }
  },
  "unique": [["speakers", "id"]],
  "secrets": [],
  "example": {
    "speakers": [
      { "id": "sonos", "url": "http://192.0.2.30:1400" },
      { "id": "sub", "url": "http://192.0.2.31:1400", "read_only": true }
    ]
  }
}
